# Supabase → Project settings → API (anon/public key only). Leave empty for offline demo mode.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# OR local mode (no Supabase): the Mac running `npm run local`, on the same Wi-Fi.
# The server prints the exact address when it starts.
EXPO_PUBLIC_LOCAL_API=
