# Supabase → Project settings → API. The service-role key is secret: Mac only, never in the app.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Ollama (local AI)
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text

# Clustering
CLUSTER_EPS_M=500
CLUSTER_MIN_POINTS=3
POLL_SECONDS=15
WINDOW_HOURS=72
